# NOTE: .gitignore does NOT support inline comments after a pattern.
# Keep comments on their own lines (learned the hard way).

# ─── SECRETS & CREDENTIALS — NEVER COMMIT ───────────────────────────────
.env
*.env
*.pem
*.key
vapid_private.pem
vapid_public.txt
*.token

# The ONE .pem that must be committed. These are PUBLIC CA intermediate certificates —
# the links some colleges' servers fail to send — not a key, and they contain no secret.
# app.py imports ca_chain at module scope and ca_chain reads this file, so a deploy
# without it leaves nine schools unreachable. Narrow exception on purpose: the *.pem rule
# above stays, because the next .pem in this repo probably IS a private key.
!ops/edu-intermediates.pem

# secret-ish filenames
*secret*
*_secret*

# ─── USER DATA — NEVER COMMIT (contains real emails / accounts) ─────────
*.db
*.sqlite
*.sqlite3
backups/
state.json

# ─── PYTHON ─────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# ─── OS / EDITOR ────────────────────────────────────────────────────────
.DS_Store
*.swp
.idea/
.vscode/
research/ctlog_sweep.log
research/ctlog_sweep_v1.log
research/ctlog_sweep_results.json
research/ctlog_sweep_results_v1_garbage.json
research/needs_retry.json
research/ctlog_secondpass_results.json
research/colleague_leads_for_codex.json

# never commit database backups (contain real user emails/watch history)
backups/
*.db
*.db.part

# Ad/media build artifacts — large binaries, not application code (Build lane, 2026-07-30)
marketing/

# Ad media: deployed to the VM with ops/push-media.sh, never committed.
# A 26 MB binary in git history is permanent and unshrinkable.
ad-web.mp4
ad-poster.jpg
marketing/*.mp4
marketing/ad-web*.mp4
marketing/*.wav
